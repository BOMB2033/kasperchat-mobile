<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_search_background_options">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/text_title_member_management"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Добавить участников"
        android:textSize="20sp"
        android:textColor="#1976D2"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Кнопка закрытия -->
    <ImageButton
        android:id="@+id/button_close_member_management"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Поле поиска -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_view_members"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/color_search_background_options"
        app:layout_constraintTop_toBottomOf="@id/text_title_member_management"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:queryHint="Поиск участников"/>

    <!-- Список пользователей -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_members"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/search_view_members"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Индикатор загрузки -->
    <ProgressBar
        android:id="@+id/progress_bar_members"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rv_members"
        app:layout_constraintBottom_toBottomOf="@id/rv_members"
        app:layout_constraintStart_toStartOf="@id/rv_members"
        app:layout_constraintEnd_toEndOf="@id/rv_members"/>

</androidx.constraintlayout.widget.ConstraintLayout>
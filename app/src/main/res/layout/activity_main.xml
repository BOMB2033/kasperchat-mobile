<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_darck"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:fontFamily="@font/didacthgothic"
        android:text="Kasper Chat"
        android:textColor="@color/white_logo_text"
        android:textSize="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/is_logo_chat" />

    <EditText
        android:id="@+id/editTextTextPassword"
        android:layout_width="293dp"
        android:layout_height="43dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/is_edit"
        android:ems="10"
        android:fontFamily="@font/signikanegative_sc_regular"
        android:textCursorDrawable="@drawable/custom_cursor"
        android:hint="Пароль"
        android:inputType="textPassword"
        android:paddingLeft="16dp"
        android:paddingBottom="3dp"
        android:textColor="#76ADC3"
        android:textColorHint="#76ADC3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextText" />

    <EditText

        android:id="@+id/editTextText"
        android:layout_width="293dp"
        android:layout_height="43dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/is_edit"
        android:ems="10"
        android:fontFamily="@font/signikanegative_sc_regular"
        android:hint="Логин"
        android:inputType="text"
        android:textCursorDrawable="@drawable/custom_cursor"
        android:paddingLeft="16dp"
        android:paddingBottom="3dp"
        android:textColor="#76ADC3"
        android:textColorHint="#76ADC3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/didacthgothic"
        android:text="Забыли пароль?"
        android:textColor="@drawable/my_text_view_selector"
        android:textSize="14dp"
        android:clickable="true"
        app:layout_constraintEnd_toEndOf="@+id/editTextTextPassword"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="@+id/editTextTextPassword"
        app:layout_constraintTop_toBottomOf="@+id/editTextTextPassword" />

    <CheckBox
        android:id="@+id/myCheckBox"
        style="@android:style/Widget.Material.CompoundButton.CheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="4dp"
        android:button="@drawable/checkbox_selector"

        android:clickable="true"
        android:fontFamily="@font/didacthgothic"
        android:layoutDirection="rtl"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="Запомнить меня?"
        android:textColor="@drawable/my_text_view_selector"
        app:buttonIconTint="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="@+id/editTextTextPassword"
        app:layout_constraintHorizontal_bias="0.03"
        app:layout_constraintStart_toStartOf="@+id/editTextTextPassword"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <Button
        android:id="@+id/button"
        android:layout_width="293dp"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/button_login_selector"
        android:fontFamily="@font/signikanegative_sc_regular"
        android:inputType="text"
        android:text="Войти"
        android:textColor="#CFD9EBFF"
        android:textSize="19dp"
        android:paddingBottom="4dp"
        android:tint="#1222AD"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/myCheckBox"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:layout_width="239dp"
        android:layout_height="55dp"
        android:layout_marginTop="9dp"
        android:clickable="true"
        android:fontFamily="@font/didacthgothic"
        android:text="У вас нет аккаунта?\nЗ ͟а͟ ͟р͟ ͟е͟ ͟г͟ ͟и͟ ͟с͟ ͟т͟ ͟р͟ ͟и͟ ͟р͟ ͟у͟ ͟й͟ ͟т͟ ͟е͟ ͟с͟ ͟ь͟͟͟͟"
        android:textAlignment="center"
        android:textColor="@drawable/my_text_view_selector"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/button"
        app:layout_constraintStart_toStartOf="@+id/button"
        app:layout_constraintTop_toBottomOf="@+id/button"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
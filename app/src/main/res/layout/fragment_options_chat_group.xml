<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll_view_chat_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layout_chat_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/background_color_options">

            <!-- Настройки уведомлений -->
            <TextView
                android:id="@+id/text_title_notifications_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки уведомлений"
                android:textSize="18sp"
                android:textColor="#1976D2"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:id="@+id/layout_mute_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/text_mute_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Заглушить уведомления"/>
                <Switch
                    android:id="@+id/switch_mute_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_custom_notification_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/text_custom_sound_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Пользовательский звук уведомления"/>
                <Spinner
                    android:id="@+id/spinner_custom_sound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <View
                android:id="@+id/divider_notifications_chat"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="16dp"/>

            <!-- Управление участниками (только для групп) -->
            <!-- TODO: реализовать изменение висибле для групп и чатов когда группа то включено когда чат то выключена-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_title_group_members"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Управление участниками"
                    android:textSize="18sp"
                    android:textColor="#1976D2"
                    android:layout_marginTop="16dp"/>

                <LinearLayout
                    android:id="@+id/layout_add_members"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <Button
                        android:id="@+id/button_add_members"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Добавить участников"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_remove_members"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <Button
                        android:id="@+id/button_remove_members"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Удалить участников"/>
                </LinearLayout>

                <View
                    android:id="@+id/divider_group_members"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="16dp"/>
</LinearLayout>
            <!-- Настройки конфиденциальности -->
            <TextView
                android:id="@+id/text_title_privacy_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Конфиденциальность"
                android:textSize="18sp"
                android:textColor="#1976D2"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:id="@+id/layout_message_expiration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/text_message_expiration_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Срок хранения сообщений"/>
                <Spinner
                    android:id="@+id/spinner_message_expiration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_encryption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/text_encryption_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Шифрование сообщений"/>
                <Switch
                    android:id="@+id/switch_encryption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <View
                android:id="@+id/divider_privacy_chat"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="16dp"/>

            <!-- Визуальные настройки -->


            <TextView
                android:id="@+id/text_title_visual_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Визуальные настройки"
                android:textSize="18sp"
                android:textColor="#1976D2"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:id="@+id/layout_name_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/text_username_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Имя чата"/>
                <EditText
                    android:id="@+id/edit_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Введите имя"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_chat_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/text_chat_background_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Фон чата"/>
                <Button
                    android:id="@+id/button_choose_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Выбрать фон"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_message_bubble_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/text_message_bubble_color_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Цвет пузырьков сообщений"/>
                <Button
                    android:id="@+id/button_choose_bubble_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Выбрать цвет"/>
            </LinearLayout>

            <View
                android:id="@+id/divider_visual_settings"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="16dp"/>

            <!-- Настройки медиа -->
            <TextView
                android:id="@+id/text_title_chat_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки чата"
                android:textSize="18sp"
                android:textColor="#1976D2"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:id="@+id/layout_button_remove_members"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/button_remove_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Удалить чат"/>
            </LinearLayout>



        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
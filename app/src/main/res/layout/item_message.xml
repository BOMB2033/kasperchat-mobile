<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="7dp"
    android:layout_marginTop="0dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Имя пользователя"
        android:textSize="13sp"
        android:layout_marginLeft="35dp"
        android:textColor="@color/text_color_login_hint_edit_text"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/signikanegative_sc_regular"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.appbroker.roundedimageview.RoundedImageView
            android:id="@+id/avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:layout_gravity="top"
            app:radius="9dp"
            android:adjustViewBounds="false"
            android:scaleType="centerCrop"

            android:src="@drawable/ic_avatar" />

        <LinearLayout
            android:id="@+id/message_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:gravity="center"
            android:background="@drawable/item_message_shape_first">

            <LinearLayout
                android:id="@+id/linearLayout_message_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:fontFamily="@font/roboto"
                    android:maxEms="15"
                    android:text="сообщение собеседника"
                    android:textColor="@color/color_message_text"
                    android:textSize="15sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:fontFamily="@font/roboto"
                    android:text="12:00"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    tools:ignore="HardcodedText" />

                <ImageView
                    android:id="@+id/imageViewReadStatus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:layout_gravity="center_vertical"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:src="@drawable/ic_double_check_blue" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
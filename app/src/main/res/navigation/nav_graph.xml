<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.kasperchat_test.fragment.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_loginFragment_to_chatsListFragment"
            app:destination="@id/chatsListFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.kasperchat_test.fragment.ChatFragment"
        android:label="fragment_chat"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="chatId"
            app:argType="string" />
        <action
            android:id="@+id/action_chatFragment_to_options_chat_group"
            app:destination="@id/options_chat_group" />
        <action
            android:id="@+id/action_chatFragment_to_chatsListFragment"
            app:destination="@id/chatsListFragment" />
    </fragment>

    <fragment
        android:id="@+id/preferensFragment"
        android:name="com.example.kasperchat_test.fragment.PreferenceFragment"
        android:label="fragment_preferens"
        tools:layout="@layout/fragment_preference">

    </fragment>

    <fragment
        android:id="@+id/chatsListFragment"
        android:name="com.example.kasperchat_test.fragment.ChatsListFragment"
        android:label="fragment_chats_list"
        tools:layout="@layout/fragment_chats_list">
        <action
            android:id="@+id/action_chatsListFragment_to_preferensFragment"
            app:destination="@id/preferensFragment" />
        <action
            android:id="@+id/action_chatsListFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_chatsListFragment_to_options_chat_group"
            app:destination="@id/options_chat_group" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.example.kasperchat_test.fragment.RegistrationFragment"
        android:label="fragment_registration"
        tools:layout="@layout/fragment_registration">
        <action
            android:id="@+id/action_registrationFragment_to_chatsListFragment"
            app:destination="@id/chatsListFragment" />
        <action
            android:id="@+id/action_registrationFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/options_chat_group"
        android:name="com.example.kasperchat_test.fragment.ChatSettingsFragment"
        android:label="fragment_options_chat_group"
        tools:layout="@layout/fragment_options_chat_group">
        <action
            android:id="@+id/action_options_chat_group_to_add_members"
            app:destination="@id/member_management_fragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out" />
        <action
            android:id="@+id/action_options_chat_group_to_remove_members"
            app:destination="@id/member_management_fragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/member_management_fragment"
        android:name="com.example.kasperchat_test.fragment.MemberManagementFragment"
        android:label="fragment_member_management"
        tools:layout="@layout/fragment_member_management" />
</navigation>
<?xml version="1.0" encoding="utf-8"?>
    <resources>
    <style name="EditStyleColor" parent="Theme.KasperChatTest">
        <item name="android:textColor">@color/text_color_login_edit_text_light</item>
        <item name="android:textColorHint">@color/text_color_login_hint_edit_text_light</item>
        <item name="android:background">@drawable/is_edit_light</item>
    </style>

    <style name="EditStyle" parent="EditStyleColor">
        <item name="android:textCursorDrawable">@drawable/custom_cursor</item>
        <item name="android:textSize">18dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/signikanegative_sc_regular</item>
    </style>

    <style name="window_login" parent="Theme.KasperChatTest">
        <item name="android:background">@color/background_color_login_screen_light</item>


    </style>
    <style name="logo_login" parent="Theme.KasperChatTest">
        <item name="android:tint">#FFFF2F</item>
    </style>

    <style name="TextLogoStyleColor" parent="Theme.KasperChatTest">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="item_chat_list" parent="Theme.KasperChatTest">
        <item name="android:background">@color/light_item_chat_list</item>
        <item name="android:selectableItemBackground">@color/light_select_item_chat_list</item>
    </style>


</resources>

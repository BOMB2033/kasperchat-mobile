<?xml version="1.0" encoding="utf-8"?>
    <resources>
    <style name="EditStyleColor" parent="Theme.KasperChatTest">
        <item name="android:textColor">@color/text_color_login_edit_text</item>
        <item name="android:textColorHint">@drawable/selector_hint_edit_text_light</item>
        <item name="android:background">@null</item> <!-- убирает фон -->
        <!-- Убираем подчеркивание -->

        <item name="boxBackgroundMode">none</item> <!-- убирает бокс -->

        <item name="boxStrokeWidth">0dp</item> <!-- убирает линию -->
    </style>

    <style name="EditStyle" parent="EditStyleColor">

        <item name="android:textCursorDrawable">@drawable/custom_cursor</item>
        <item name="android:textSize">18dp</item>
        <item name="android:paddingLeft">15dp</item>
        <!-- Центрируем hint -->
        <item name="hintTextAppearance">@style/HintTextStyle</item>
        <!-- Текст слева направо при вводе -->
        <item name="android:textAlignment">viewStart</item>
        <item name="android:fontFamily">@font/signikanegative_sc_regular</item>
    </style>

    <!-- Стиль для hint -->
    <style name="HintTextStyle">
        <item name="android:fontFamily">@font/signikanegative_sc_regular</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18dp</item>
    </style>
    <style name="options_button" parent="Theme.KasperChatTest">
        <item name="android:src">@drawable/options_light</item>
    </style>

    <style name="search_button" parent="Theme.KasperChatTest">
        <item name="android:src">@drawable/search_light</item>
    </style>

    <style name="add_channel_button" parent="Theme.KasperChatTest">
        <item name="android:src">@drawable/add_channel_light</item>
    </style>

    <style name="AuthTitleStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/logo_text</item> <!-- Цвет текста -->
        <item name="android:textSize">25sp</item> <!-- Размер текста -->
        <item name="android:fontFamily">@font/signikanegative_sc_regular</item> <!-- Шрифт (убедитесь, что этот шрифт добавлен в res/font) -->
        <item name="android:shadowColor">@color/black</item> <!-- Цвет тени -->
        <item name="android:shadowDx">2</item> <!-- Смещение тени по X -->
        <item name="android:shadowDy">2</item> <!-- Смещение тени по Y -->
        <item name="android:shadowRadius">2</item> <!-- Радиус размытия тени -->
    </style>
    <style name="FloatingHintStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">19sp</item> <!-- Размер текста -->
        <item name="android:textColor">@color/text_color_hint</item> <!-- Цвет текста (пример) -->
        <item name="hintTextColor">@color/text_color_hint</item> <!-- Цвет текста хинта -->
         <item name="android:translationY">-15dp</item> <!-- Поднять хинт выше -->

    </style>


</resources>

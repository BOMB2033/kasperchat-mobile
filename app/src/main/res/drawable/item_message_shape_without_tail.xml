<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">

        <shape
            android:shape="rectangle">
            <solid android:color="?color_item_message_send" />
            <corners android:topLeftRadius="15dp" android:radius="15dp" />
        </shape>
    </item >
    <item android:state_enabled="false">

        <shape
            android:shape="rectangle">
            <solid android:color="?color_item_message_shadow_send" />
            <corners android:topLeftRadius="15dp" android:radius="15dp" />
        </shape>
    </item>

</selector>
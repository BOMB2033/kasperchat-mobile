<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- background color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#283343" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- bottom shadow -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#2D3A4C" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
